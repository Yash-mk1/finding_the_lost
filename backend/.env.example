# Copy to .env and adjust. docker-compose reads this file automatically.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Set to false whenever the server is reachable from the internet (for example
# through the tunnel), and set a real DJANGO_SECRET_KEY above. Generate one:
#   docker compose run --rm api python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Asia/Kolkata

POSTGRES_DB=ftl
POSTGRES_USER=ftl
POSTGRES_PASSWORD=ftl
# "db" inside docker-compose, "localhost" when Postgres runs on your machine
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Windows without Docker only: point at your OSGeo4W DLLs, e.g.
# GDAL_LIBRARY_PATH=C:\OSGeo4W\bin\gdal309.dll
# GEOS_LIBRARY_PATH=C:\OSGeo4W\bin\geos_c.dll

# Email for sign-up codes. Leave EMAIL_HOST_USER empty to print the codes in
# the server log instead (docker compose logs api) - fine for a demo.
# For Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and paste it below.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Findit <you@gmail.com>

# Or send through Brevo's web API instead (needed on hosts that block email
# ports, such as Render's free tier). DEFAULT_FROM_EMAIL must then be a sender
# verified in Brevo.
# BREVO_API_KEY=

# Set to false only for quick local testing without email codes.
FTL_REQUIRE_EMAIL_VERIFICATION=true

# Keep true when using the HTTPS tunnel (or any HTTPS proxy).
BEHIND_HTTPS_PROXY=true

# App rules
FTL_POST_LIFETIME_DAYS=30
FTL_APPROX_RADIUS_M=250
FTL_AUTO_HIDE_REPORTS=3
SERVE_MEDIA=true

# ---- Hosted setup only (Render + Supabase); leave unset for docker-compose ----
# One connection string instead of the POSTGRES_* values above.
# DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Photos in S3-compatible storage (Supabase Storage) instead of on disk.
# S3_BUCKET=photos
# S3_ENDPOINT_URL=https://<project>.supabase.co/storage/v1/s3
# S3_PUBLIC_DOMAIN=<project>.supabase.co/storage/v1/object/public/photos
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Created/updated on every start, for hosts with no command line.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
# SEED_DEMO=false
